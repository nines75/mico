{
  "name": "mico",
  "description": "ニコニコ動画用のコンテンツブロッカー",
  "version": "7.14.1",
  "type": "module",
  "engines": {
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11.25.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wxt --browser firefox --mv2",
    "build": "wxt build --browser firefox --mv2",
    "zip": "wxt zip --browser firefox --mv2",
    "postinstall": "wxt prepare",
    "preversion": "pnpm check",
    "compile": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier . --write --list-different",
    "format:ci": "prettier . --check",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:scheduled": "playwright test",
    "check": "concurrently 'pnpm build' 'pnpm compile' 'pnpm lint' 'pnpm format:ci' 'pnpm test:ci'",
    "playwright:install": "playwright install firefox"
  },
  "dependencies": {
    "@ag-grid-community/locale": "^36.1.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/proxy-service": "^3.0.2",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "clsx": "^2.1.1",
    "deepmerge-ts": "^8.0.1",
    "delay": "^7.0.0",
    "dexie": "^4.4.5",
    "lucide-react": "^1.31.0",
    "modern-normalize": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-extras": "^1.3.0",
    "type-fest": "^5.8.0",
    "virtua": "^0.50.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}
